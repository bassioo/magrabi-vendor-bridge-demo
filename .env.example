# ---- MAGRABi Vendor Hub ----------------------------------------------------
# demo: seeded sample data, simulated registries, emails kept in the Outbox, quick sign-in.
# live: real users only, registries need keys, emails go through SMTP.
APP_MODE=demo
PORT=8787
PUBLIC_URL=http://localhost:5173
DATA_DIR=./data
SESSION_SECRET=change-me-to-a-long-random-string

# First administrator (created on start if missing)
ADMIN_EMAIL=procurement@magrabi.example
ADMIN_NAME=Deena

# Email (optional). Without SMTP, emails are stored in the Outbox only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MAGRABi Vendor Hub <no-reply@magrabi.example>"

# AI document reading (optional). Without a key, fields are marked "needs review" in live mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Registries (optional). Without keys, lookups are "manual verification".
WATHQ_API_KEY=
WATHQ_BASE_URL=https://api.wathq.sa/v5

# Reminders
REMINDER_AFTER_DAYS=3
